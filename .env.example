# Copy to .env and fill in. .env is gitignored — never commit it.

FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Where the React client runs (used for CORS).
CLIENT_URL=http://localhost:5173

# Leave DATABASE_URL unset to use SQLite, which needs no setup at all.
# Switch to Postgres when you are ready:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neighborly

# Secrets. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# Set to true to log every SQL statement.
SQL_ECHO=false

# ── Deploying to Vercel ─────────────────────────────────────────────────────
# Set these four in Project Settings → Environment Variables, not here.
# ProductionConfig refuses to start without the last three, so a missing one
# surfaces as a failed deploy rather than a deployment running on dev secrets.
#
#   FLASK_ENV=production
#   SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">
#   JWT_SECRET_KEY=<a second, different token>
#   DATABASE_URL=<Neon connection string — use the POOLED host, the one
#                 with "-pooler" in it, since each request may hit a cold
#                 instance and pgbouncer should own the pooling>
#
# The client needs no VITE_API_URL: vercel.json serves the API and the SPA
# from one origin, so the default relative "/api" base already resolves.
