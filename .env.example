# Copy to .env and fill in. .env is gitignored — never commit it.

FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Where the React client runs (used for CORS).
CLIENT_URL=http://localhost:5173

# Leave DATABASE_URL unset to use SQLite, which needs no setup at all.
# Switch to Postgres when you are ready:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neighborly

# Secrets. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# Set to true to log every SQL statement.
SQL_ECHO=false
